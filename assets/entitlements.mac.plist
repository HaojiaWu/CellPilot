<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <!-- Required for Electron / V8 JIT compilation -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <!-- Required for Electron to map unsigned executable memory -->
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <!-- Required for loading third-party native modules (sharp, etc.) -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
    <!-- Network access for LLM APIs and session tracking -->
    <key>com.apple.security.network.client</key>
    <true/>
    <!-- Read/write user-selected files (datasets) -->
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>
    <!-- Downloads folder access for saving results -->
    <key>com.apple.security.files.downloads.read-write</key>
    <true/>
  </dict>
</plist>
